{
  "name": "sera-assistant-root",
  "private": true,
  "scripts": {
    "server": ".\\venv\\Scripts\\python.exe main.py --ui",
    "backend": ".\\venv\\Scripts\\python.exe main.py --ui",
    "dev": "npm --prefix frontend run dev",
